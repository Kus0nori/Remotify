<Window x:Class="Remotify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
        Title="Remotify">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app.ico" Width="16" Height="16" />
                <TextBlock Text="Remotify" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="4" MaxWidth="600">

                <!-- Status -->
                <controls:SettingsCard x:Name="StatusCard"
                                       Header="Сервер запущен"
                                       Description="Ожидание подключений"
                                       IsClickEnabled="False">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE73E;" Foreground="Green" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!-- Connection Section Header -->
                <TextBlock Text="Подключение"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,24,0,8" />

                <!-- IP Address -->
                <controls:SettingsCard Header="IP-адрес"
                                       Description="Локальный адрес в сети">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="IpAddressText"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <Button Click="CopyIp_Click" ToolTipService.ToolTip="Копировать">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Port -->
                <controls:SettingsCard Header="Порт"
                                       Description="Порт API сервера">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="PortNumberBox"
                                   Minimum="1" Maximum="65535"
                                   SpinButtonPlacementMode="Compact"
                                   Width="120" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Authorization Section Header -->
                <TextBlock Text="Авторизация"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,24,0,8" />

                <!-- Token -->
                <controls:SettingsCard Header="Токен"
                                       Description="Для подключения мобильного приложения">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TokenText"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Click="CopyToken_Click" ToolTipService.ToolTip="Копировать">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                        <Button Click="RegenerateToken_Click" ToolTipService.ToolTip="Сгенерировать новый">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Settings Section Header -->
                <TextBlock Text="Настройки"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,24,0,8" />

                <!-- Auto Start -->
                <controls:SettingsCard Header="Автозапуск"
                                       Description="Запускать при старте Windows">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoStartToggle"
                                  OnContent="" OffContent=""
                                  Toggled="AutoStartToggle_Toggled" />
                </controls:SettingsCard>

                <!-- Firewall -->
                <controls:SettingsCard Header="Брандмауэр"
                                       Description="Открыть порт (требует прав администратора)">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE83D;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="FirewallToggle"
                                  OnContent="" OffContent=""
                                  Toggled="FirewallToggle_Toggled" />
                </controls:SettingsCard>

                <!-- Info -->
                <InfoBar x:Name="InfoMessage"
                         IsOpen="False"
                         Severity="Success"
                         Margin="0,16,0,0" />

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="0,24,0,0">
                    <Button Content="Сохранить"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Save_Click" />
                    <Button Content="Закрыть"
                            Click="Close_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
